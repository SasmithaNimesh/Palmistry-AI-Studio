# Copy to .env (never commit it) or export these as environment variables
GEMINI_API_KEY=your-key-here
# Optional. Leave unset (recommended) and the app picks the first working model for your key:
#   gemini-3.6-flash, gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash
# (gemini-2.0-flash was shut down by Google.) Run: python tools/check_gemini.py
# GEMINI_MODEL=gemini-3.6-flash
